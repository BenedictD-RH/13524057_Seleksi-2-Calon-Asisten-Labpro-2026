# Copy this to .env and fill in real secrets before running docker compose.

# MySQL root passwords for each database service
AUTH_PROVIDER_DB_PASS=changeme
MESSAGE_QUEUE_DB_PASS=changeme

# Service-to-service addresses. These are container-network addresses (service
# name + MySQL's in-container port 3306) — NOT the "5342"/"5343" host ports
# published in docker-compose.yml, which are only for connecting from your
# host machine (e.g. a MySQL GUI client).
AUTH_PROVIDER_DB_ADDRESS=auth-provider-db:3306
MESSAGE_QUEUE_ADDRESS=message-queue:3306

# Origins allowed by the server's CORS config — must match how the frontends
# are actually reached (browser-facing URL, including scheme and port).
# Note: the nginx containers serving the built frontends do NOT terminate TLS
# (only auth-provider-server does, via its own cert), so these are http://.
AUTH_PORTAL_URL=http://localhost:8081
ADMIN_CONSOLE_URL=http://localhost:8082
